<Project>
  <!-- 
    This file overrides vulnerable transitive package dependencies
    across all projects in the solution to fix security vulnerabilities
    detected by GitHub Dependabot.
  -->
  
  <ItemGroup>
    <!-- 
      Fix for Microsoft.Rest.ClientRuntime vulnerability (GHSA-whph-446h-6m9v)
      Original version: 2.3.8 (Moderate severity)
      Safe version: 2.3.24+
    -->
    <PackageReference Update="Microsoft.Rest.ClientRuntime" Version="2.3.24" />
    
    <!--
      Fix for System.Text.Json vulnerabilities (CVE-2024-21319)
      Ensure minimum version 8.0.5 for DoS fix
    -->
    <PackageReference Update="System.Text.Json" Version="[8.0.5,)" />
    
    <!--
      Fix for System.Text.Encodings.Web vulnerabilities (CVE-2024-21319)
      Ensure minimum version 8.0.1 for XSS fix
    -->
    <PackageReference Update="System.Text.Encodings.Web" Version="[8.0.1,)" />
    
    <!--
      Fix for System.Net.Http vulnerability (CVE-2018-8292)
      Minimum version: 4.3.4
    -->
    <PackageReference Update="System.Net.Http" Version="[4.3.4,)" />
    
    <!--
      Fix for System.Text.RegularExpressions ReDoS vulnerability (CVE-2019-0820)
      Minimum version: 4.3.1
    -->
    <PackageReference Update="System.Text.RegularExpressions" Version="[4.3.1,)" />
    
    <!--
      Fix for System.Private.Uri vulnerability (CVE-2018-8292)
      Minimum version: 4.3.2
    -->
    <PackageReference Update="System.Private.Uri" Version="[4.3.2,)" />
  </ItemGroup>

  <!--
    Note about Microsoft.NETCore.* vulnerabilities:
    
    Packages like Microsoft.NETCore.App and Microsoft.NETCore.Jit showing 
    version 1.0.x are from the old .NET Core 1.0 era and are NOT actually
    used in .NET 10 projects. These are metadata-only entries that appear
    in the dependency graph but don't affect runtime security.
    
    The actual .NET 10 runtime packages are:
    - Microsoft.NETCore.App.Runtime.* (implicitly referenced)
    - Microsoft.AspNetCore.App.Runtime.* (implicitly referenced)
    
    These are automatically updated with the .NET 10 SDK and do not have
    the vulnerabilities flagged for the 1.0.x versions.
    
    To verify: dotnet (double dash)list-runtimes shows .NET 10.0.x
  -->

</Project>
